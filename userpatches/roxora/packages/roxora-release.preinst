#!/bin/sh
# preinst of roxora-release (userpatches/roxora/packages/ in
# https://github.com/roxora-os/build).
set -e

# Images up to 2026.11.4 have Roxora's configuration files without a
# package. Move such a file aside when no package owns it and it is exactly
# as an image wrote it (one of the SHA-256 sums given), so that dpkg installs
# this package's version without asking. postinst removes the copy; postrm
# puts it back if the installation is aborted. An edited file stays where it
# is, and dpkg asks about it as about any changed configuration file.
take_over() {
	path="$1"
	shift
	[ -f "$path" ] && [ ! -L "$path" ] || return 0
	! dpkg-query -S "$path" > /dev/null 2>&1 || return 0
	sum="$(sha256sum "$path" | cut -d ' ' -f 1)"
	for known in "$@"; do
		if [ "$sum" = "$known" ]; then
			mv -f "$path" "$path.roxora-takeover"
			return 0
		fi
	done
	return 0
}

# Ubuntu's release upgrader (do-release-upgrade) edits the source lists it
# does not know: it adds "Enabled: no", or, with
# RELEASE_UPGRADER_ALLOW_THIRD_PARTY=1, changes the suite (and only the
# suite: Armbian's components keep the old release's name). Where a source
# list of the previous Ubuntu release's package is exactly such an edit,
# write back what that package shipped, so that dpkg replaces it with this
# release's version instead of asking about it. Any other change stays.
restore_rewrite() {
	path="$1"
	shipped="$2"
	shift 2
	[ -f "$path" ] || return 0
	sum="$(sha256sum "$path" | cut -d ' ' -f 1)"
	for known in "$@"; do
		if [ "$sum" = "$known" ]; then
			printf '%s' "$shipped" > "$path"
			return 0
		fi
	done
	return 0
}

if [ "$1" = install ] || [ "$1" = upgrade ]; then
@TAKEOVER@
fi
if [ "$1" = upgrade ]; then
@REWRITES@
fi

exit 0
